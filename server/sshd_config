Port 22
AddressFamily inet
ListenAddress 0.0.0.0

# Force compression -- the client connects with -C so the negotiation picks
# zlib@openssh.com.
Compression yes

HostKey /etc/ssh/server_host_key

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
# Allow root via pubkey only. Used by /set_sudo_secret to remotely change
# the victim's sudo password between attack runs.
PermitRootLogin prohibit-password
AllowUsers victim root

AllowTcpForwarding yes
GatewayPorts no

LogLevel INFO
